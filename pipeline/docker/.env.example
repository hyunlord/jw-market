# MariaDB credentials
# Copy this file to .env and replace every changeme-* value before running Docker.
MARIADB_ROOT_PASSWORD=changeme-root
MARIADB_PASSWORD=changeme-app
MARIADB_GALERA_MARIABACKUP_PASSWORD=changeme-backup

# DB name / user
# Usually unchanged for the local mart development environment.
MARIADB_DATABASE=jw_mart
MARIADB_USER=jwapp

# Host port
# Change when local MySQL/MariaDB already uses 3307.
HOST_PORT=3307

# ETL storage backend
# Use local for existing Mac/local workflows. Use minio for GKE ETL staging.
ETL_STORAGE_BACKEND=local
MINIO_ENDPOINT=http://minio.llmops.svc.cluster.local:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET_RAW_IQVIA=jw-market-raw-iqvia
MINIO_BUCKET_RAW_UBIST=jw-market-raw-ubist
MINIO_BUCKET_RAW_JW_MAPPING=jw-market-raw-jw-mapping
MINIO_BUCKET_ENRICHED=jw-market-enriched
ETL_WORK_DIR=/tmp/jw-market-etl
