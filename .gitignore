# Phase B git hygiene: keep source in git, keep generated/raw/binary data out.

# Archives and packaged artifacts
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z
*.image.tar
jw-market-backend-api-*.tar
jw-market-*.tar

# Local database state
pipeline/docker/data/
docker/data/

# Raw data moved to object storage
data/
!data/.gitkeep

# Generated ETL and analysis outputs
output/
!output/.gitkeep
outputs/
parquet/
deprecated/
viewer/
reports/
exports/
audits/
phase_*/
phase_*_audit_*/
phase_*_audit_*.zip
*_audit_*.zip
audit_*.zip

# Large data formats
*.parquet
*.sqlite
*.db
*.csv.gz

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# Logs and temporary files
*.log
*.bak
*.tmp
/tmp/

# Mac / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
*.iml

# Excel temporary lock files
~$*

# Runtime metadata
.omx/
.codex_metadata/

# Secrets
.env
.env.*
!.env.example
!pipeline/docker/.env.example
!docker/.env.example
secrets/
