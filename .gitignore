# Phase B git hygiene: keep source in git, keep generated/raw/binary data out.

# Archives and packaged artifacts
*.tar
*.tar.gz
*.tgz
*.zip
*.zip.sha256
*.rar
*.7z
*.image.tar
jw-market-backend-api-*.tar
jw-market-*.tar

# Local database state
pipeline/docker/data/
docker/data/

# Raw data moved to object storage
data/
!data/.gitkeep
inputs/molecule_v4_worklist.csv

# Documentation and audit artifacts moved out of source git
docs/*
!docs/reference/
!docs/reference/**
docs/reference/*.xlsx
# Runtime catalog input; keep other untracked crawl artifacts ignored.
!docs/crawl/
docs/crawl/*
!docs/crawl/search_keywords.json
audit_*.json
audit_F5_*

# Generated ETL and analysis outputs
output/
!output/.gitkeep
outputs/
parquet/
deprecated/
viewer/
reports/
exports/
audits/
# Generated phase outputs at the repository root only. Nested phase_* paths may
# be Python packages and must remain visible to git.
/phase_*/
phase_*_audit_*/
phase_*_audit_*.zip
*_audit_*.zip
audit_*.zip

# Large data formats
*.parquet
*.sqlite
*.db
*.csv.gz

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# Logs and temporary files
*.log
*.bak
*.tmp
/tmp/

# Mac / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
*.iml

# Excel temporary lock files
~$*

# Runtime metadata
.omx/

# Phase B-5 - removed source-history-only areas; keep local copies untracked.
archive/
pipeline_restructure/
db/
.codex_metadata/

# Secrets
.env
.env.*
!.env.example
!pipeline/docker/.env.example
!docker/.env.example
secrets/

# Phase B-6 - root scripts were folded into pipeline/scripts.
/scripts/

# GitHub hygiene remediation 2026-06-18: keep agent state, audit bundles,
# raw root data, credentials, and DB dumps local-only.
# Agent-internal working state (Codex/OMX)
.omo/
*.omx

# Audit deliverables stay local
audit/
audit_*/
initializationError
sample_news_*.json

# Root-level raw spreadsheets/CSV must not slip in (data/ already ignored)
/*.xlsx
/*.csv

# Secrets and credentials (hard block)
.rnd_creds*
*.rnd_creds*
*.key
*.pem
*.p12
*.pfx

# DB dumps (NOT migrations)
*.dump
*.sql
!pipeline/migrations/*.sql
!pipeline/migrations/**/*.sql
!**/migrations/*.sql
!**/migrations/**/*.sql
