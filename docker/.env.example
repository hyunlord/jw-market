# MariaDB credentials
# Copy this file to .env and replace every changeme-* value before running Docker.
MARIADB_ROOT_PASSWORD=changeme-root
MARIADB_PASSWORD=changeme-app
MARIADB_GALERA_MARIABACKUP_PASSWORD=changeme-backup

# DB name / user
# Usually unchanged for the local mart development environment.
MARIADB_DATABASE=jw_mart
MARIADB_USER=jwapp

# Host port
# Change when local MySQL/MariaDB already uses 3307.
HOST_PORT=3307

